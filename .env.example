# Projeto e portas locais
COMPOSE_PROJECT_NAME=estilo-marcado
POSTGRES_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=4200
PGADMIN_PORT=5050
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
FRONTEND_URL=http://localhost:4200
AUTH_ALLOWED_ORIGINS=http://localhost:4200
AUTH_PASSWORD_COST=12
SESSION_COOKIE_SECURE=false

# Garante um administrador para a unidade informada a cada inicializacao.
AUTH_BOOTSTRAP_ADMIN_ENABLED=false
AUTH_BOOTSTRAP_ADMIN_NAME=Administrador
AUTH_BOOTSTRAP_ADMIN_EMAIL=
# Use um ID de unidade existente ou deixe 0 para criar/localizar pelo nome.
AUTH_BOOTSTRAP_ADMIN_UNIT_ID=0
AUTH_BOOTSTRAP_ADMIN_UNIT_NAME=Unidade Administrativa

# PostgreSQL — somente desenvolvimento local
POSTGRES_DB=estilo_marcado
POSTGRES_USER=estilo_marcado
POSTGRES_PASSWORD=troque-esta-senha-local

# pgAdmin — somente desenvolvimento local
PGADMIN_DEFAULT_EMAIL=admin@estilomarcado.local
PGADMIN_DEFAULT_PASSWORD=troque-esta-senha-local
