# Projeto e portas locais
COMPOSE_PROJECT_NAME=estilo-marcado
POSTGRES_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=4200
PGADMIN_PORT=5050
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
FRONTEND_URL=http://localhost:4200
AUTH_ALLOWED_ORIGINS=http://localhost:4200
AUTH_PASSWORD_COST=12
SESSION_COOKIE_SECURE=false

# Firebase Auth: habilite somente depois de importar e conferir as contas.
FIREBASE_AUTH_ENABLED=false
FIREBASE_AUTH_IMPORT_EXISTING=false
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_AUTH_DOMAIN=
FIREBASE_WEB_APP_ID=
# Caminho do JSON da conta de serviço, montado apenas no backend.
FIREBASE_ADMIN_CREDENTIALS_PATH=/run/firebase/service-account.json
# Apenas desenvolvimento com Firebase Auth Emulator (sem https://).
FIREBASE_AUTH_EMULATOR_HOST=
FIREBASE_AUTH_EMULATOR_BROWSER_URL=
MAIL_FROM=nao-responda@estilomarcado.local

# Cria ou promove os e-mails informados como administradores da unidade configurada.
# Conta de cliente existente precisa estar ativa e, com Firebase, ter e-mail verificado.
AUTH_BOOTSTRAP_ADMIN_ENABLED=false
AUTH_BOOTSTRAP_ADMIN_NAME=Administrador
AUTH_BOOTSTRAP_ADMIN_EMAIL=
# Preencha para adicionar outro administrador sem substituir o e-mail inicial.
AUTH_ADDITIONAL_ADMIN_EMAIL=
AUTH_ADDITIONAL_ADMIN_NAME=Administrador
# Use um ID de unidade existente ou deixe 0 para criar/localizar pelo nome.
AUTH_BOOTSTRAP_ADMIN_UNIT_ID=0
AUTH_BOOTSTRAP_ADMIN_UNIT_NAME=Unidade Administrativa

# PostgreSQL — somente desenvolvimento local
POSTGRES_DB=estilo_marcado
POSTGRES_USER=estilo_marcado
POSTGRES_PASSWORD=troque-esta-senha-local

# pgAdmin — somente desenvolvimento local
PGADMIN_DEFAULT_EMAIL=admin@estilomarcado.local
PGADMIN_DEFAULT_PASSWORD=troque-esta-senha-local
