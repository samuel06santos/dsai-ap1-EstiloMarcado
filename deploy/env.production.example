# Modelo de variaveis de ambiente de PRODUCAO do Estilo Marcado.
#
# Copie para deploy/.env.production (ignorado pelo Git) e preencha:
#   cp deploy/env.production.example deploy/.env.production
#   chmod 600 deploy/.env.production
#
# Suba com:
#   docker compose --env-file deploy/.env.production -f docker-compose.prod.yml up -d --build

COMPOSE_PROJECT_NAME=estilo-marcado-prod

# --- Dominio publico --------------------------------------------------------
FRONTEND_URL=https://estilomarcado.samuelsantos.qzz.io
AUTH_ALLOWED_ORIGINS=https://estilomarcado.samuelsantos.qzz.io

# Onde o frontend escuta no host (somente loopback, para o nginx do host).
FRONTEND_BIND=127.0.0.1:8081

# --- Banco de dados ---------------------------------------------------------
POSTGRES_DB=estilo_marcado
POSTGRES_USER=estilo_marcado
# Gere uma senha forte e unica: openssl rand -base64 32
POSTGRES_PASSWORD=TROQUE-POR-UMA-SENHA-FORTE

# --- Sessao e autenticacao --------------------------------------------------
SESSION_COOKIE_SECURE=true
AUTH_PASSWORD_COST=12
FIREBASE_AUTH_ENABLED=false
FIREBASE_AUTH_IMPORT_EXISTING=false
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_AUTH_DOMAIN=
FIREBASE_WEB_APP_ID=
# Coloque o JSON da conta de servico em deploy/firebase/service-account.json.
FIREBASE_ADMIN_CREDENTIALS_PATH=/run/firebase/service-account.json
# Deixe "true" apenas na primeira subida, para criar o administrador inicial,
# e depois volte para "false" e recrie o backend.
AUTH_BOOTSTRAP_ADMIN_ENABLED=false
AUTH_BOOTSTRAP_ADMIN_NAME=Administrador
AUTH_BOOTSTRAP_ADMIN_EMAIL=admin@estilomarcado.samuelsantos.qzz.io
AUTH_BOOTSTRAP_ADMIN_UNIT_ID=0
AUTH_BOOTSTRAP_ADMIN_UNIT_NAME=Unidade Administrativa

# --- E-mail (SMTP real) -----------------------------------------------------
# Mailpit existe somente em desenvolvimento. Em producao, aponte para um SMTP
# real, pois e por ele que saem ativacao, convite e recuperacao de senha.
MAIL_HOST=smtp.seudominio.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=nao-responda@seudominio.com
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
